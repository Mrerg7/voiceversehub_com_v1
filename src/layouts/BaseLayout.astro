---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "voiceversehub.com | Premium Domain for Sale | VoiceVerse Hub",
  description = "Buy voiceversehub.com — premium exact-match .com for sale. The category name for AI voice, generative music, and creator tools. Price on request. Escrow transfer. Inquire at sales@desertrich.com.",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/ea083567-12c2-4c32-05fe-e6b33c732400/public";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "VoiceVerse Hub",
      url: "https://voiceversehub.com/",
      email: "sales@desertrich.com",
      description: "Seller presentation for the premium domain voiceversehub.com.",
    },
    {
      "@type": "WebSite",
      name: "voiceversehub.com",
      url: "https://voiceversehub.com/",
      description,
      publisher: { "@type": "Organization", name: "VoiceVerse Hub" },
    },
    {
      "@type": "WebPage",
      name: title,
      url: canonical,
      description,
      isPartOf: { "@type": "WebSite", name: "VoiceVerse Hub", url: "https://voiceversehub.com/" },
    },
    {
      "@type": "Product",
      name: "voiceversehub.com",
      category: "Premium domain name",
      brand: { "@type": "Brand", name: "VoiceVerse Hub" },
      description: "Premium exact-match .com domain for sale. Category name for AI voice, verse, and generative audio.",
      url: "https://voiceversehub.com/",
      offers: {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        priceCurrency: "USD",
        url: "https://voiceversehub.com/#inquire",
        description: "Price on request. Confidential inquiry. Escrow transfer available.",
        seller: { "@type": "Organization", name: "VoiceVerse Hub", email: "sales@desertrich.com" },
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Is voiceversehub.com for sale?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. voiceversehub.com is a premium .com offered for acquisition. Price is on request via sales@desertrich.com.",
          },
        },
        {
          "@type": "Question",
          name: "How do I buy voiceversehub.com?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Submit an offer or request terms. Transfers are completed through a licensed escrow service after both parties agree.",
          },
        },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="VoiceVerse Hub" />
    <meta name="theme-color" content="#0c0e12" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="google-site-verification" content="AB7gzAHCxxXxbMT3_jENF0RnhwcnKSQBNMDdN6cJdww" />
    <meta name="keywords" content="buy .com domains, domain marketplace, voiceversehub.com for sale, premium domain names, investment domains, brandable domains" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:title" content="voiceversehub.com — Premium Domain" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VoiceVerse Hub" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="voiceversehub.com — Premium Domain" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      try { if (localStorage.getItem("vv-theme") === "light") document.documentElement.classList.add("light"); } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
